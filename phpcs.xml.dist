<?xml version="1.0"?>
<ruleset name="Shola Jawid">
	<description>WPCS ruleset for the Shola Jawid theme and Shola Core plugin.</description>

	<file>./wp-content/themes/shola-jawid</file>
	<file>./wp-content/plugins/shola-core</file>

	<arg value="sp"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<rule ref="WordPress-Extra">
		<exclude name="WordPress.Files.FileName"/>
		<!--
			GlobalVariablesOverride flags ordinary local variables (`$term`,
			`$paged`, etc.) that happen to share a name with a WordPress
			global, even in template files where assigning `$term =
			get_queried_object();` or `$paged = get_query_var('paged');` is
			completely standard WP template-hierarchy code, not a real
			collision risk. Excluded project-wide after a full phpcs run
			(2026-08-07) confirmed every one of its 40 findings across this
			codebase was exactly this false-positive pattern in a template
			file, none in shola-core. Logged as a deliberate ruleset
			decision in docs/CHANGELOG.md, not a silent suppression.
		-->
		<exclude name="WordPress.WP.GlobalVariablesOverride.Prohibited"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="shola-jawid"/>
				<element value="shola-core"/>
			</property>
		</properties>
	</rule>

	<config name="minimum_supported_wp_version" value="6.4"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="PHPCompatibilityWP"/>
</ruleset>
